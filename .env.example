# Copy to .env for local runs. Docker Compose sets these itself.

# HTTP port of the API.
PORT=3000

# Postgres connection string. The schema comes from the SQL files in migrations/.
DATABASE_URL=postgres://wdp:wdp@localhost:5432/wdp

# Redis connection string (per-tenant ingest rate limit).
REDIS_URL=redis://localhost:6379

# Per-tenant ingest limit: tokens refilled per second, and bucket size.
INGEST_RATE_PER_SECOND=100
INGEST_BURST=200

# Development only: comma-separated hosts that may be registered as endpoints
# over plain http and any port, so the mock receiver can be used. The worker
# reads the same variable and lets those hosts through its SSRF guard. Leave
# empty in production. (docker-compose.yml sets it to mock-receiver.)
SSRF_ALLOW_HOSTS=

# --- Outbox relay (apps/relay) ---
# It also reads DATABASE_URL above.

# RabbitMQ connection string.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Prefix of every exchange and queue; every service of one deployment shares it.
BROKER_NAMESPACE=wdp

# Events taken per batch, pause after a batch that was not full, how long to
# wait for the broker's confirm, and the pause after a failed run (all in ms
# except the batch size).
RELAY_BATCH_SIZE=200
RELAY_POLL_INTERVAL_MS=100
RELAY_CONFIRM_TIMEOUT_MS=5000
RELAY_ERROR_BACKOFF_MS=1000

# --- Dispatcher (apps/dispatcher) ---
# It also reads DATABASE_URL, RABBITMQ_URL and BROKER_NAMESPACE from above.

# Number of fresh-delivery lanes (4 locally, 16 in the design). Changing it
# remaps endpoints to lanes, so drain the lane queues first.
LANE_COUNT=4

# Events handled at once, and how long to wait for the broker's confirm (ms).
DISPATCHER_PREFETCH=20
DISPATCHER_CONFIRM_TIMEOUT_MS=5000

# A failed dispatch (a publish error, a subscription lookup error) waits this
# long in a retry queue (ms), then is dispatched again as a whole. After this
# many tries in total it is dead-lettered with its reason.
DISPATCHER_RETRY_DELAY_MS=5000
DISPATCHER_MAX_ATTEMPTS=10

# --- Mock receiver (apps/mock-receiver) ---
# Its behaviour is set per request through the URL's query string, see the README.
# It listens on PORT (default 4000). That name is the API's too, so give it its
# own environment instead of setting it here, as docker-compose.yml does:
#   PORT=4000 node apps/mock-receiver/dist/main.js

# --- Worker (apps/worker) ---
# HTTP port of GET /status. It is called PORT like the API's, so give it its
# own environment instead of setting it here, as docker-compose.yml does:
#   PORT=3001 node apps/worker/dist/main.js
# The default is 3001.
# It also reads DATABASE_URL, RABBITMQ_URL, BROKER_NAMESPACE, LANE_COUNT (must
# match the dispatcher's) and SSRF_ALLOW_HOSTS from above: with the allowlist
# empty, only public https hosts are called. Plus:

# Jobs handled at once per lane queue (PRD: 20).
WORKER_PREFETCH=20

# Retries handled at once, from the shared retry.ready queue (PRD: 5).
WORKER_RETRY_PREFETCH=5

# Divides every retry delay (5 s ... 10 h): 1 in production, 30 for a demo,
# 1000 in tests. It is part of the retry queues' names, so a new value makes
# new queues instead of failing; jobs still waiting in the old ones run out as
# before.
TIME_SCALE=1
# No retry delay is shorter than this many ms, however large the scale (PRD:
# 500 for a demo, 20 in tests).
RETRY_MIN_DELAY_MS=0

# MongoDB, where the worker logs every delivery attempt (30-day TTL). Required.
MONGO_URL=mongodb://localhost:27017
# Database the attempts collection lives in.
MONGO_DB=wdp
