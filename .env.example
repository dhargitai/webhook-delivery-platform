# Copy to .env for local runs. Docker Compose sets these itself.

# HTTP port of the API.
PORT=3000

# Postgres connection string. The schema comes from the SQL files in migrations/.
DATABASE_URL=postgres://wdp:wdp@localhost:5432/wdp

# Redis connection string (per-tenant ingest rate limit).
REDIS_URL=redis://localhost:6379

# Per-tenant ingest limit: tokens refilled per second, and bucket size.
INGEST_RATE_PER_SECOND=100
INGEST_BURST=200
